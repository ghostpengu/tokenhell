{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenHell",
  "version": "0.1.0",
  "identifier": "io.github.ghostpengu.tokenhell",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "panel",
        "title": "TokenHell",
        "url": "index.html",
        "width": 360,
        "height": 560,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": true,
        "visibleOnAllWorkspaces": true,
        "windowEffects": {
          "effects": ["liquidGlassRegular", "popover"],
          "state": "active",
          "radius": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Token usage and AI plan limits in your menu bar",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  }
}
